# ---------------------------------------------------------------------------
# DEL Herren Friseur Barber Shop - variables d'environnement
# Copier ce fichier en .env.local puis remplir les valeurs.
# Sans ces variables, l'app demarre en MODE DEMO (donnees locales, aucune
# ecriture distante). Pratique pour developper la landing sans backend.
# ---------------------------------------------------------------------------

# URL du projet Supabase, ex: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Cle publique (anon / publishable). Exposee au navigateur, c'est normal :
# la securite repose sur les policies RLS, pas sur le secret de cette cle.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Identifiant court du projet Supabase (utilise par la CLI supabase)
VITE_SUPABASE_PROJECT_ID=

# Domaine public du site, utilise pour les liens canoniques, Open Graph,
# le JSON-LD et le fichier .ics. Sans slash final.
VITE_SITE_URL=https://delherren.app

# ---------------------------------------------------------------------------
# SECRETS SUPABASE (a definir cote serveur uniquement, JAMAIS ici)
#   supabase secrets set RESEND_API_KEY=...
#   supabase secrets set TELEGRAM_BOT_TOKEN=...
#   supabase secrets set TELEGRAM_CHAT_ID=...
#   supabase secrets set BOOKING_FROM_EMAIL="DEL Herren <termin@delherren.app>"
# ---------------------------------------------------------------------------
